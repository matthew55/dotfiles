get_short_stage_name() {
  case "$1" in
    "Bob-omb Battlefield") echo "BOB" ;;
    "Whomp's Fortress") echo "WF" ;;
    "Jolly Roger Bay") echo "JRB" ;;
    "Cool, Cool Mountain") echo "CCM" ;;
    "Big Boo's Haunt") echo "BBH" ;;
    "Hazy Maze Cave") echo "HMC" ;;
    "Lethal Lava Land") echo "LLL" ;;
    "Shifting Sand Land") echo "SSL" ;;
    "Dire, Dire Docks") echo "DDD" ;;
    "Snowman's Land") echo "SL" ;;
    "Wet-Dry World") echo "WDW" ;;
    "Tall, Tall Mountain") echo "TTM" ;;
    "Tiny-Huge Island") echo "THI" ;;
    "Tick Tock Clock") echo "TTC" ;;
    "Rainbow Ride") echo "RR" ;;
    "Castle Secret Stars") echo "Castle Secret Stars" ;;
  esac
}

main_menu() {
  printf "Home\nPlatforms\nCategories\nGeneral Gameplay\nSingle Stars" | $ROFI_CMD "Main Menu"
}

open_url() {
  local base_url="https://ukikipedia.net/wiki/RTA_Guide"
  xdg-open "${base_url}${1:+/${1// /_}}"
  exit 0
}

while true; do
  choice=$(main_menu)

  case "$choice" in
    "Home")
      open_url
      ;;
    "Platforms")
      selected=$(printf "<-- Back\n%s" "$(printf "%s\n" "${platforms[@]}")" | $ROFI_CMD "Platforms")
      if [[ "$selected" == "<-- Back" ]]; then continue; fi
      [ -n "$selected" ] && open_url "$selected"
      ;;

    "Categories")
      selected=$(printf "<-- Back\n%s" "$(printf "%s\n" "${categories[@]}")" | $ROFI_CMD "Categories")
      if [[ "$selected" == "<-- Back" ]]; then continue; fi
      [ -n "$selected" ] && open_url "$selected"
      ;;

    "General Gameplay")
      selected=$(printf "<-- Back\n%s" "$(printf "%s\n" "${general[@]}")" | $ROFI_CMD "Gameplay")
      if [[ "$selected" == "<-- Back" ]]; then continue; fi
      [ -n "$selected" ] && open_url "$selected"
      ;;

    "Single Stars")
      while true; do
        stage_list="<-- Back\n"
        for s in "${stages[@]}"; do
          short=$(get_short_stage_name "$s")
          if [ "$s" == "$short" ]; then
              stage_list+="$s\n"
          else
              stage_list+="$s ($short)\n"
          fi
        done

        selected_line=$(echo -e "$stage_list" | sed '/^$/d' | $ROFI_CMD "Stages")
        
        if [[ -z "$selected_line" || "$selected_line" == "<-- Back" ]]; then break; fi

        stage=$(echo "$selected_line" | sed 's/ (.*)//')
        stars=$(get_stars "$stage")
        star=$(printf "%s\n" "$stars" | $ROFI_CMD "$stage")

        if [[ -n "$star" && "$star" != "<-- Back" ]]; then
          if [ "$star" == "Stage Info" ]; then
            short_name=$(get_short_stage_name "$stage")
            open_url "$short_name"
          else
            open_url "$star"
          fi 
        fi
      done
      ;;

    *)
      exit 0
      ;;
  esac
done
